# Backend API (dev-plan-07-frontend-base)
# Used by the browser (src/lib/api.ts) — must be reachable from the client,
# so it's the host-mapped port, never the Docker-internal hostname.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend API for server-side rendering (dev-plan-09-frontend-learn).
# No NEXT_PUBLIC_ prefix — never bundled to the client (see src/lib/serverApi.ts).
# Inside docker-compose, the Next.js server reaches line-api via the internal
# network hostname; if running `next dev`/`next start` directly on the host
# instead, override this to http://localhost:8080.
API_URL=http://line-api:8080
