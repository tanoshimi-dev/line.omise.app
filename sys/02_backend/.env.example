# Server
PORT=8080

# Database (PostgreSQL — decided in dev-plan-02-database.md)
# Host is "postgres" (the docker-compose service name) when line-api runs
# via `docker compose up`; use "localhost" instead if running
# `go run ./cmd/server` directly on the host against the port-mapped container.
DATABASE_URL=postgres://line_omise:line_omise@postgres:5432/line_omise_app?sslmode=disable

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://line.omise.app

# Environment: "development" (default) or "production". Only affects the
# session cookie's Secure flag (dev-plan-04-auth) — set to "production" on
# the real VPS deploy (Step 13), where the site is served over HTTPS.
APP_ENV=development

# Where the browser is sent back to after a login/OAuth callback completes.
# Must be the Next.js frontend's own origin (it renders /auth/callback).
FRONTEND_URL=http://localhost:3000

# LINE Login / Google OAuth — dev-plan-04-auth
# Get real values from the LINE Developers console / Google Cloud console
# (see dev-plan-04-auth.md 4.1) — these are required for login to work.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:8080/auth/line/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Comma-separated emails auto-promoted to role=admin on login.
ADMIN_EMAILS=

# Required — signs the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
