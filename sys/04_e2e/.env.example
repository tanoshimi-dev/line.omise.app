# Base URL of the running frontend (docker-compose maps line-web to this port).
BASE_URL=http://localhost:3000

# Direct Postgres connection for seeding test users/sessions (bypasses real
# OAuth — see doc/dev-plans/result/dev-plan-12-test-phase1-result.md for why).
# Host-mapped port, since this runs on the host, not inside docker-compose.
DATABASE_URL=postgres://line_omise:line_omise@localhost:5432/line_omise_app?sslmode=disable

# Must exactly match sys/02_backend/.env's SESSION_SECRET, or seeded session
# cookies won't verify against the running backend.
SESSION_SECRET=
